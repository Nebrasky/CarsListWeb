@model IReadOnlyList<RepositorySetting>

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mb-4">
    <h1 class="display-4">Available Cars</h1>
    <p class="text-muted">Browse the current list of cars and their price ranges.</p>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead class="table-success">
            <tr>
                <th scope="col">Model</th>
                <th scope="col">Year</th>
                <th scope="col">Min Price</th>
                <th scope="col">Max Price</th>
            </tr>
        </thead>
        <tbody>
            @if (Model is { Count: > 0 })
            {
                foreach (var repo in Model)
                {
                    <tr>
                        <td>@repo.Model</td>
                        <td>@repo.Year</td>
                        <td>@repo.MinPrice.ToString("C")</td>
                        <td>@repo.MaxPrice.ToString("C")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No cars available.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
